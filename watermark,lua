local function makeTextPill(
	row: Frame,
	name: string,
	buildIcon: IconBuilder?,
	valueText: string,
	accented: boolean?
): (Frame, TextLabel)
	local pill = Instance.new("Frame")
	pill.Name = name
	pill.AutomaticSize = Enum.AutomaticSize.X
	pill.Size = UDim2.fromOffset(0, PILL_HEIGHT)
	local stroke = stylePill(pill, accented)
	pill.Parent = row

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 9)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = pill

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 5)
	layout.Parent = pill

	local iconColor = if accented then Color3.fromRGB(255, 255, 255) else CONFIG.Accent

	local iconFrame: Instance? = nil
	if buildIcon ~= nil then
		iconFrame = buildIcon(iconColor)
		iconFrame.Name = "Icon"
		iconFrame.LayoutOrder = 1
		iconFrame.Parent = pill
	end

	local value = Instance.new("TextLabel")
	value.Name = "Value"
	value.LayoutOrder = 2
	value.AutomaticSize = Enum.AutomaticSize.X
	value.Size = UDim2.fromOffset(0, PILL_HEIGHT)
	value.BackgroundTransparency = 1
	value.Font = Enum.Font.BuilderSansBold
	value.Text = valueText
	value.TextSize = 13
	value.TextColor3 = Color3.fromRGB(246, 246, 250)
	value.Parent = pill

	if accented then
		attachHover(pill, stroke, 0.3, 0.05)
	else
		attachHover(pill, stroke, 0.85, 0.25)
	end

	pill.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			copyToClipboard(value.Text)
		end
	end)

	registerPill(row, pill, iconFrame, value)

	return pill, value
end

