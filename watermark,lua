local dragging = false
local followTarget = false
local dragTarget = holderRest
local tiltCurrent = 0
local tiltTarget = 0

local function clampedPosition(pos: UDim2): UDim2
	local cam = workspace.CurrentCamera
	if not cam then
		return pos
	end
	local viewport = cam.ViewportSize
	local size = holder.AbsoluteSize * scale.Scale
	local margin = CONFIG.EdgeMargin
	return UDim2.fromOffset(
		math.clamp(pos.X.Offset, margin, math.max(margin, viewport.X - size.X - margin)),
		math.clamp(pos.Y.Offset, margin, math.max(margin, viewport.Y - size.Y - margin))
	)
end

local function clampHolder()
	local pos = holder.Position
	local clamped = clampedPosition(pos)
	if clamped ~= pos then
		holder.Position = clamped
	end
end

if CONFIG.Draggable then
	local dragStart = Vector2.zero
	local startPosition = holder.Position
	local activeInput: InputObject? = nil

	holder.Active = true

	holder.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			followTarget = false
			activeInput = input
			dragStart = input.Position
			startPosition = holder.Position
			dragTarget = startPosition
			TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Scale = CONFIG.Scale * 1.05,
			}):Play()
		end
	end)

	holder.InputEnded:Connect(function(input: InputObject)
		if input == activeInput then
			dragging = false
			followTarget = true
			activeInput = nil
			TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Scale = CONFIG.Scale,
			}):Play()
		end
	end)

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if not dragging then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local delta = input.Position - dragStart
		dragTarget = clampedPosition(UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		))
	end)
end

local frames = 0
