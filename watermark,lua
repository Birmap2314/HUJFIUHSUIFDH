RunService.RenderStepped:Connect(function(step: number)
	frames += 1
	local now = os.clock()

	if now - lastFpsUpdate >= 0.75 then
		fps = math.floor(frames / (now - lastFpsUpdate) + 0.5)
		frames = 0
		lastFpsUpdate = now
		bandwidth = getBandwidth()
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local p = root.Position
		coordsLabel.Text = string.format("%.0f, %.0f, %.0f", p.X, p.Y, p.Z)
	else
		coordsLabel.Text = "—, —, —"
	end

	fpsLabel.Text = string.format("%d FPS", fps)
	pingLabel.Text = string.format("%d ms", getPing())
	bandwidthLabel.Text = string.format("%.1f KB/s", bandwidth)

	local before = holder.Position
	local dist = math.max(
		math.abs(dragTarget.X.Offset - before.X.Offset),
		math.abs(dragTarget.Y.Offset - before.Y.Offset)
	)

	if dragging or (followTarget and dist > 0.5) then
		local a = math.min(1, step * 16)
		local nx = before.X.Offset + (dragTarget.X.Offset - before.X.Offset) * a
		local ny = before.Y.Offset + (dragTarget.Y.Offset - before.Y.Offset) * a
		holder.Position = UDim2.fromOffset(nx, ny)
		if dragging then
			local velocity = (nx - before.X.Offset) / math.max(step, 1e-4)
			tiltTarget = math.clamp(velocity * 0.004, -5, 5)
		end
		if followTarget and dist <= 0.5 then
			followTarget = false
		end
	else
		followTarget = false
		tiltTarget = 0
	end

	if not dragging then
		tiltTarget = 0
	end

	tiltCurrent += (tiltTarget - tiltCurrent) * math.min(1, step * 10)
	if tiltTarget == 0 and math.abs(tiltCurrent) < 0.01 then
		tiltCurrent = 0
	end
	holder.Rotation = tiltCurrent

	updateSide()
	clampHolder()
end)
