local function stylePill(pill: Frame, accented: boolean?): UIStroke
	pill.BackgroundColor3 = if accented then Color3.fromRGB(70, 50, 140) else Color3.fromRGB(24, 24, 29)
	pill.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = pill

	local stroke = Instance.new("UIStroke")
	stroke.Color = if accented then CONFIG.Accent else Color3.fromRGB(255, 255, 255)
	stroke.Transparency = if accented then 0.3 else 0.85
	stroke.Thickness = 1
	stroke.Parent = pill

	local gradient = Instance.new("UIGradient")
	gradient.Color = if accented
		then ColorSequence.new(Color3.fromRGB(122, 90, 214), Color3.fromRGB(44, 29, 88))
		else ColorSequence.new(Color3.fromRGB(54, 54, 64), Color3.fromRGB(14, 14, 19))
	gradient.Rotation = 90
	gradient.Parent = pill

	return stroke
end

local mouse = player:GetMouse()
local defaultCursor = mouse.Icon
local POINTING_CURSOR = "rbxasset://SystemCursors/PointingHand"

local function attachHover(target: GuiObject, stroke: UIStroke, baseTransparency: number, hoverTransparency: number)
	local active: Tween? = nil

	target.MouseEnter:Connect(function()
		if active then
			active:Cancel()
		end
		active = TweenService:Create(stroke, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Transparency = hoverTransparency,
		})
		active:Play()
		mouse.Icon = POINTING_CURSOR
	end)

	target.MouseLeave:Connect(function()
		if active then
			active:Cancel()
		end
		active = TweenService:Create(stroke, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Transparency = baseTransparency,
		})
		active:Play()
		mouse.Icon = defaultCursor
	end)
end

local function copyToClipboard(text: string)
	local env = getfenv()
	local fn = env.setclipboard or env.set_clipboard or env.toclipboard or env.writeclipboard
	if typeof(fn) == "function" then
		pcall(fn, text)
	end
end

