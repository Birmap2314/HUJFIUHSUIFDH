		{ UDim2.new(0.5, 0, 0, 0.5), Vector2.new(0.5, 0), UDim2.fromOffset(1.3, 2.5) },
		{ UDim2.new(0.5, 0, 1, -0.5), Vector2.new(0.5, 1), UDim2.fromOffset(1.3, 2.5) },
		{ UDim2.new(0, 0.5, 0.5, 0), Vector2.new(0, 0.5), UDim2.fromOffset(2.5, 1.3) },
