local lastFpsUpdate = os.clock()
local bandwidth = 0

local function getPing(): number
	local ok, value = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	return if ok and typeof(value) == "number" then math.floor(value + 0.5) else 0
end

local function getBandwidth(): number
	local ok, value = pcall(function()
		return Stats.DataReceiveKbps
	end)
	return if ok and typeof(value) == "number" then math.max(0, value) else 0
end

local currentSide = 0

local function applySide(side: number)
	if side == currentSide then
		return
	end
	currentSide = side
	local mirrored = side == 2

	badge.LayoutOrder = if mirrored then 1 else 0
	rows.LayoutOrder = if mirrored then 0 else 1

	local rowCounts: { [Frame]: number } = {}
	for _, record in pillRecords do
		rowCounts[record.row] = (rowCounts[record.row] or 0) + 1
	end

	local rowIndexes: { [Frame]: number } = {}
	for _, record in pillRecords do
		local row = record.row
		local idx = rowIndexes[row] or 0
		rowIndexes[row] = idx + 1
		record.pill.LayoutOrder = if mirrored then rowCounts[row] - 1 - idx else idx
		if record.icon ~= nil then
			record.icon.LayoutOrder = if mirrored then 2 else 1
		end
		if record.value ~= nil then
			record.value.LayoutOrder = if mirrored then 1 else 2
		end
	end
end

local function updateSide()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local viewport = cam.ViewportSize
	local size = holder.AbsoluteSize * scale.Scale
	local centerX = holder.AbsolutePosition.X + size.X / 2
	local mid = viewport.X / 2
	if currentSide == 0 then
		applySide(if centerX < mid then 1 else 2)
	elseif currentSide == 1 and centerX > mid + SIDE_HYSTERESIS then
		applySide(2)
	elseif currentSide == 2 and centerX < mid - SIDE_HYSTERESIS then
		applySide(1)
	end
end

